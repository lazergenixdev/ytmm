[Unit]
Description=Update ytmm server and download dependencies
After=network-online.target

[Service]
Type=oneshot
Environment="PATH=%h/.deno/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/uv tool upgrade ytmm
ExecStartPost=/usr/bin/systemctl --user try-restart ytmm.service
